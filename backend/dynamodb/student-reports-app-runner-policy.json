{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StudentReportsTableReadsAndTransactions",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Scan",
        "dynamodb:BatchWriteItem",
        "dynamodb:TransactWriteItems"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/FlytoezStudentReports"
    },
    {
      "Sid": "StudentReportsIndexes",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": [
        "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/FlytoezStudentReports/index/ClassIndex",
        "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/FlytoezStudentReports/index/NameIndex"
      ]
    },
    {
      "Sid": "CostumeMeasurementsReportRosterIntegration",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/CostumeMeasurements"
    }
  ]
}
