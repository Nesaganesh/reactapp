# AWS Configuration (for DynamoDB)
# Local development: Add your AWS credentials
# Production (App Runner): Uses IAM role automatically, no credentials needed
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# DynamoDB Table Name
DYNAMODB_TABLE=CostumeMeasurements

# Server Port
# Use 5000 for local development
# AWS App Runner will set this to 8080 automatically
PORT=5000

# Node Environment
NODE_ENV=development
